# .env.example
# Copy to .env and fill in your values

# Cloudflare Turnstile
# WARNING: The key below is the Cloudflare TEST site key — it renders a
# "For testing only" widget and must NEVER be used in production. If
# PUBLIC_TURNSTILE_SITE_KEY is unset in production the widget is skipped
# and the contact form shows localized fallback (email/WhatsApp) instead.
# Set a real site key in your Cloudflare Pages environment variables.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Form backend (Cloudflare Pages Function)
INQUIRY_RECIPIENT_EMAIL=sales@sdnfaucet.com

# WhatsApp number (international format, no +)
PUBLIC_WHATSAPP_NUMBER=8613064536291
