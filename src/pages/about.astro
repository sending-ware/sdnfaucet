---
import MainLayout from "@layouts/MainLayout.astro";
---

<MainLayout
  title="About Us"
  description="Learn about Quanzhou Shengdanni Sanitary Ware - our manufacturing expertise, quality standards, and commitment to global B2B partners."
>
  <section class="section-padding">
    <div class="container-tight">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="heading-1">About SDN Faucet</h1>
        <p class="mt-4 text-lg text-gray-500">
          From Quanzhou's manufacturing hub to global markets.
        </p>
      </div>

      <div class="mt-16 mx-auto max-w-3xl space-y-12">
        <div>
          <h2 class="heading-2">Who We Are</h2>
          <p class="mt-4 leading-relaxed text-gray-500">
            Quanzhou Shengdanni Sanitary Ware Co., Ltd. is a professional manufacturer
            based in Nan'an, Quanzhou — one of China's largest sanitary ware production
            clusters. We specialize in the design, manufacturing, and export of kitchen
            faucets, basin mixers, shower systems, and bathroom accessories.
          </p>
        </div>

        <div>
          <h2 class="heading-2">Our Advantage</h2>
          <ul class="mt-4 space-y-3">
            {[
              "Factory-direct pricing with no middleman markup",
              "Rigorous quality control — pressure, finish, and function testing on every batch",
              "Flexible MOQ for trial orders and mixed containers",
              "International packaging and labeling compliant with destination market requirements",
              "OEM/ODM capability — custom design, finish, and branding",
              "Strategic location in Quanzhou with efficient logistics to major Chinese ports",
            ].map((item) => (
              <li class="flex items-start gap-3 text-gray-500">
                <span class="mt-1 shrink-0 text-ocean-500">✓</span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="heading-2">Our Commitment</h2>
          <p class="mt-4 leading-relaxed text-gray-500">
            We believe in building long-term partnerships through product quality,
            honest communication, and reliable delivery. Every inquiry gets a personal
            response — no bots, no templates.
          </p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
