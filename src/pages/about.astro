---
import MainLayout from "@layouts/MainLayout.astro";
---

<MainLayout 
  title="About Us | Professional Faucet Manufacturer in Quanzhou"
  description="Quanzhou Shengdanni Sanitary Ware Co., Ltd. is a professional manufacturer of faucets and shower systems. Learn about our quality standards, factory-direct wholesale, and OEM/ODM capabilities."
>
  <section class="section-padding bg-white">
    <div class="container-tight px-4">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="heading-1">About SDN Faucet</h1>
        <p class="mt-4 text-gray-500">
          From Quanzhou's manufacturing hub to global markets.
        </p>
      </div>

      <div class="mt-16 grid gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-2xl font-bold text-gray-900">Who We Are</h2>
          <p class="mt-4 text-lg leading-relaxed text-gray-500">
            Quanzhou Shengdanni Sanitary Ware Co., Ltd. is a professional manufacturer 
            based in Anxi County, Quanzhou — one of China's largest sanitary ware production 
            clusters. We specialize in the design, manufacturing, and export of kitchen 
            faucets, basin mixers, shower systems, and bathroom accessories.
          </p>
        </div>
        <div class="rounded-2xl bg-ocean-50 p-8 sm:p-12">
          <h2 class="text-2xl font-bold text-gray-900">Our Advantage</h2>
          <ul class="mt-6 space-y-4 text-gray-600">
            <li class="flex items-start gap-3">
              <span class="text-ocean-600">✓</span>
              <span>Factory-direct pricing with no middleman markup</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-ocean-600">✓</span>
              <span>Flexible MOQ for trial orders and mixed containers</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-ocean-600">✓</span>
              <span>International packaging and labeling compliance</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-ocean-600">✓</span>
              <span>OEM/ODM capability — custom design and branding</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Our Factory Showcase -->
      <div class="mt-24 border-t border-gray-100 pt-16">
        <div class="mx-auto mb-12 max-w-2xl text-center">
          <h2 class="text-3xl font-bold text-gray-900">Our Factory</h2>
          <p class="mt-4 text-gray-500">
            Step inside our production facility in Anxi County, Quanzhou — where precision 
            engineering meets international quality standards.
          </p>
        </div>

        <figure class="overflow-hidden rounded-2xl bg-white shadow-lg ring-1 ring-gray-100">
          <img
            src="https://sc02.alicdn.com/kf/A085f47d0bc0b43f5a0b088e0504c8d4f0.png"
            alt="Inside the SDN Faucet factory in Quanzhou — automated sanitary ware production line"
            class="h-auto w-full object-cover"
            width="1600"
            height="900"
            loading="lazy"
          />
          <figcaption class="border-t border-gray-100 bg-gray-50 px-6 py-5 text-center text-sm text-gray-500">
            Our production lines in Quanzhou, China — every faucet is manufactured, pressure-tested, 
            and packed to export-ready standards.
          </figcaption>
        </figure>

        <div class="mt-12 grid gap-6 sm:grid-cols-3">
          <div class="rounded-2xl border border-gray-100 bg-ocean-50/50 p-8 text-center">
            <div class="text-2xl font-bold text-ocean-700">ISO 9001</div>
            <p class="mt-2 text-sm text-gray-500">Certified quality management</p>
          </div>
          <div class="rounded-2xl border border-gray-100 bg-ocean-50/50 p-8 text-center">
            <div class="text-2xl font-bold text-ocean-700">100% QC</div>
            <p class="mt-2 text-sm text-gray-500">Every unit pressure-tested</p>
          </div>
          <div class="rounded-2xl border border-gray-100 bg-ocean-50/50 p-8 text-center">
            <div class="text-2xl font-bold text-ocean-700">OEM/ODM</div>
            <p class="mt-2 text-sm text-gray-500">Custom design and branding</p>
          </div>
        </div>
      </div>

      <!-- 新增：质量保障与信任模块 -->
      <div class="mt-24 border-t border-gray-100 pt-16">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900">Global Quality Standards</h2>
          <p class="mt-4 text-gray-500">Every product is tested to meet international performance and safety benchmarks.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div class="text-center p-6 border border-gray-100 rounded-xl hover:shadow-md transition-shadow">
            <div class="text-ocean-600 font-bold text-xl mb-2">ISO 9001</div>
            <p class="text-xs text-gray-400">Quality Management</p>
          </div>
          <div class="text-center p-6 border border-gray-100 rounded-xl hover:shadow-md transition-shadow">
            <div class="text-green-600 font-bold text-xl mb-2">CE Mark</div>
            <p class="text-xs text-gray-400">European Standards</p>
          </div>
          <div class="text-center p-6 border border-gray-100 rounded-xl hover:shadow-md transition-shadow">
            <div class="text-blue-600 font-bold text-xl mb-2">100% QC</div>
            <p class="text-xs text-gray-400">Pressure Tested</p>
          </div>
          <div class="text-center p-6 border border-gray-100 rounded-xl hover:shadow-md transition-shadow">
            <div class="text-orange-600 font-bold text-xl mb-2">5 YEARS</div>
            <p class="text-xs text-gray-400">Reliable Warranty</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
