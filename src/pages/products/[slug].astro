---
import { getCollection } from "astro:content";
import MainLayout from "@layouts/MainLayout.astro";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await product.render();
---

<MainLayout 
  title={product.data.title}
  description={product.data.description || `Explore SDN Faucet ${product.data.title}. Professional sanitary ware quality.`}
  image={product.data.image}
>
  <section class="section-padding bg-white">
    <div class="container-tight px-4">
      <!-- Breadcrumb -->
      <nav class="mb-8 text-sm text-gray-500">
        <a href="/" class="hover:text-ocean-600">Home</a>
        <span class="mx-2">/</span>
        <a href="/products" class="hover:text-ocean-600">Products</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900">{product.data.title}</span>
      </nav>

      <div class="grid gap-12 lg:grid-cols-2">
        <!-- Image Gallery -->
        <div class="space-y-6">
          <figure class="overflow-hidden rounded-xl border border-gray-100 bg-white p-4">
            <img 
              src={product.data.image} 
              alt={`${product.data.title} - Lifestyle`}
              class="w-full h-auto object-contain"
              loading="eager"
            />
            <figcaption class="mt-3 text-center text-xs font-medium uppercase tracking-widest text-gray-400">
              Lifestyle
            </figcaption>
          </figure>
          
          {product.data.tech_image && (
            <figure class="overflow-hidden rounded-xl border border-gray-100 bg-white p-4">
              <img 
                src={product.data.tech_image} 
                alt={`${product.data.title} - Technical`}
                class="w-full h-auto object-contain"
                loading="lazy"
              />
              <figcaption class="mt-3 text-center text-xs font-medium uppercase tracking-widest text-gray-400">
                Technical / Selling Point
              </figcaption>
            </figure>
          )}
        </div>

        <!-- Product Info -->
        <div>
          <h1 class="heading-2">{product.data.title}</h1>
          <p class="mt-2 text-sm font-medium text-ocean-600 uppercase tracking-wider">
            Model: {product.data.model}
          </p>
          
          <div class="mt-8 space-y-6">
            <div class="rounded-xl bg-gray-50 p-6">
              <h2 class="text-sm font-bold uppercase tracking-wider text-gray-900">Key Specifications</h2>
              <dl class="mt-4 grid grid-cols-1 gap-x-4 gap-y-3 sm:grid-cols-2">
                {Object.entries(product.data.specs).map(([key, value]) => (
                  <div>
                    <dt class="text-xs font-medium text-gray-400 uppercase">{key.replace(/([A-Z])/g, ' $1')}</dt>
                    <dd class="mt-1 text-sm font-semibold text-gray-900">
                      {Array.isArray(value) ? value.join(", ") : value}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>

            <div class="prose prose-sm prose-ocean max-w-none">
              <Content />
            </div>

            <div class="pt-8">
              <a 
                href="/contact" 
                class="btn-primary w-full justify-center py-4 text-lg"
              >
                Inquiry for Wholesale Price
              </a>
              <p class="mt-4 text-center text-xs text-gray-400">
                ✓ Factory Direct  ✓ 24h Response  ✓ OEM/ODM Support
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
