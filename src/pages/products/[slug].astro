---
import { getCollection } from "astro:content";
import MainLayout from "@layouts/MainLayout.astro";
import QuickInquiry from "@components/inquiry/QuickInquiry";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((p) => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const { Content } = await product.render();
const { title, model, specs } = product.data;

const categoryLabels: Record<string, string> = {
  "kitchen-faucets": "Kitchen Faucets",
  "basin-faucets": "Basin Faucets",
  "shower-systems": "Shower Systems",
  "bath-mixers": "Bath Mixers",
  accessories: "Accessories",
};
---

<MainLayout
  title={title}
  description={`${title} (${model}) - Professional sanitary ware manufacturer from Quanzhou, China. Inquire for pricing and samples.`}
>
  <section class="section-padding">
    <div class="container-tight">
      <!-- Breadcrumb -->
      <nav class="mb-8 text-sm text-gray-400">
        <a href="/" class="hover:text-ocean-600">Home</a>
        <span class="mx-2">/</span>
        <a href="/products" class="hover:text-ocean-600">Products</a>
        <span class="mx-2">/</span>
        <span class="text-gray-600">{title}</span>
      </nav>

      <div class="grid gap-12 lg:grid-cols-5">
        <!-- Left: Product Info -->
        <div class="lg:col-span-3">
          <span class="inline-block rounded-full bg-ocean-100 px-3 py-1 text-xs font-medium text-ocean-700">
            {categoryLabels[product.data.category] || product.data.category}
          </span>
          <h1 class="mt-4 heading-1">{title}</h1>
          <p class="mt-2 text-lg text-ocean-600 font-mono">{model}</p>

          <!-- Specs -->
          {
            specs && (
              <div class="mt-8 rounded-xl border border-gray-100 bg-gray-50 p-6">
                <h3 class="text-sm font-semibold text-gray-900">Specifications</h3>
                <dl class="mt-4 grid gap-3 sm:grid-cols-2">
                  {specs.material && (
                    <div>
                      <dt class="text-xs text-gray-400">Material</dt>
                      <dd class="text-sm font-medium text-gray-700">{specs.material}</dd>
                    </div>
                  )}
                  {specs.finish && (
                    <div>
                      <dt class="text-xs text-gray-400">Finish</dt>
                      <dd class="text-sm font-medium text-gray-700">{specs.finish}</dd>
                    </div>
                  )}
                  {specs.type && (
                    <div>
                      <dt class="text-xs text-gray-400">Type</dt>
                      <dd class="text-sm font-medium text-gray-700">{specs.type}</dd>
                    </div>
                  )}
                </dl>
              </div>
            )
          }

          <!-- Features -->
          {
            specs?.features && specs.features.length > 0 && (
              <div class="mt-6">
                <h3 class="heading-3">Features</h3>
                <ul class="mt-3 space-y-2">
                  {specs.features.map((f) => (
                    <li class="flex items-start gap-2 text-sm text-gray-600">
                      <span class="mt-1 shrink-0 text-ocean-500">✓</span>
                      {f}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <!-- Full Description (Markdown) -->
          <div class="prose prose-gray mt-10 max-w-none">
            <Content />
          </div>
        </div>

        <!-- Right: Inquiry Form -->
        <div class="lg:col-span-2">
          <div class="sticky top-24 rounded-xl border border-ocean-100 bg-white p-6 shadow-lg">
            <h2 class="heading-3">Quick Inquiry</h2>
            <p class="mt-1 text-sm text-gray-500">
              Get pricing, MOQ, and samples for {model}
            </p>
            <div class="mt-6">
              <QuickInquiry
                client:load
                productModel={model}
                productName={title}
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
