---
import MainLayout from "@layouts/MainLayout.astro";
import QuickInquiry from "@components/inquiry/QuickInquiry";
---

<MainLayout 
  title="Contact & Inquiry"
  description="Contact SDN Faucet for high-quality kitchen and bathroom sanitary ware. We offer professional OEM/ODM services and direct factory pricing."
>
  <section class="section-padding bg-white">
    <div class="container-tight px-4">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="heading-1">Get in Touch</h1>
        <p class="mt-4 text-gray-500">
          Tell us your product requirements. We'll respond within 24 hours.
        </p>
      </div>

      <div class="mt-12">
        <QuickInquiry client:load />
      </div>

      <div class="mt-20 rounded-2xl bg-gray-50 p-8 sm:p-12">
        <h2 class="text-2xl font-bold text-gray-900">Other Ways to Reach Us</h2>
        <div class="mt-4 space-y-4 text-sm text-gray-500">
          <p>
            <strong>Email:</strong> 
            <a href="mailto:sending@sdnfaucet.com" class="text-ocean-600 hover:underline">sending@sdnfaucet.com</a>
          </p>
          <p>
            <strong>TEL/WHATSAPP:</strong> 
            <a href="tel:+8617750519615" class="text-ocean-600 hover:underline">+86 17750519615</a>
          </p>
          <p>
            <strong>Address:</strong> Room 501, Building 1, Defa Technology, Chengxiang Town, Anxi County, Quanzhou City, Fujian Province, China
          </p>
          <p>
            <strong>Response time:</strong> Within 24 hours on business days
          </p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
