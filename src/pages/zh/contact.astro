---
import MainLayout from "@layouts/MainLayout.astro";
import QuickInquiry from "@components/inquiry/QuickInquiry";

const inquiryLabels = {
  name: "姓名",
  email: "邮箱",
  company: "公司",
  quantity: "数量（约）",
  requirements: "需求描述",
  namePlaceholder: "请输入您的姓名",
  emailPlaceholder: "your@company.com",
  companyPlaceholder: "请输入公司名称",
  quantityPlaceholder: "例如 500 件",
  messagePlaceholder: "请告知：目标市场、表面处理偏好、OEM需求、包装要求……",
  nameRequired: "请填写姓名",
  emailRequired: "请填写邮箱",
  emailInvalid: "请输入有效的邮箱地址",
  messageRequired: "请描述您的需求",
  interestTemplate: "我对{productName}（{productModel}）感兴趣，请发送价格和起订量信息。",
  submit: "立即发送询价",
  submitting: "提交中……",
  successTitle: "询价已发送成功！",
  successMessage: "我们将审核您的需求并在24小时内回复。",
  errorMessage: "提交失败，请重试，或直接发送邮件至 sales@sdnfaucet.com",
  turnstileError: "安全验证未完成，请重试验证，或直接通过邮件或 WhatsApp 联系我们。",
  turnstileRetry: "重新验证",
  turnstileConfigMessage: "询价表单暂时不可用，请直接联系我们：",
  turnstileFallbackEmail: "发送邮件",
  turnstileFallbackWhatsApp: "WhatsApp 联系",
  privacyNote: "受 Turnstile 保护。您的信息仅用于回复本次询价。",
};
---

<MainLayout
  lang="zh"
  title="联系我们与询价 | SDN Faucet"
  description="联系 SDN Faucet，获取高品质厨房与卫浴洁具。我们提供专业的OEM/ODM服务和工厂直销价格。"
>
  <section class="section-padding bg-white">
    <div class="container-tight px-4">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="heading-1">联系我们</h1>
        <p class="mt-4 text-gray-500">
          告诉我们您的产品需求，我们将在24小时内回复。
        </p>
      </div>

      <div class="mt-12">
        <QuickInquiry client:load {inquiryLabels} />
      </div>

      <div class="mt-20 rounded-2xl bg-gray-50 p-8 sm:p-12">
        <h2 class="text-2xl font-bold text-gray-900">其他联系方式</h2>
        <div class="mt-4 space-y-4 text-sm text-gray-500">
          <p>
            <strong>邮箱：</strong>
            <a href="mailto:sending@sdnfaucet.com" class="text-ocean-600 hover:underline">sending@sdnfaucet.com</a>
          </p>
          <p>
            <strong>电话/WhatsApp：</strong>
            <a href="tel:+8613064536291" class="text-ocean-600 hover:underline">+86 13064536291</a> /
            <a href="tel:+8617750519615" class="text-ocean-600 hover:underline">+86 17750519615</a>
          </p>
          <p>
            <strong>地址：</strong>中国福建省泉州市安溪县城厢镇德阀科技园1号楼501室
          </p>
          <p>
            <strong>回复时间：</strong>工作日24小时内
          </p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
