---
import MainLayout from "@layouts/MainLayout.astro";
import fs from "node:fs";
import path from "node:path";

const catalogPath = path.resolve("./public/data/catalog.json");
const allCatalogItems = JSON.parse(fs.readFileSync(catalogPath, "utf-8"));

const categoryLabels: Record<string, string> = {
  all: "全部产品",
  "kitchen-faucets": "厨房水龙头",
  "basin-faucets": "面盆龙头",
  "shower-systems": "淋浴系统",
  "bath-mixers": "浴缸混水龙头",
  accessories: "卫浴配件",
};

const categoryIcons: Record<string, string> = {
  all: "📦",
  "kitchen-faucets": "🚰",
  "basin-faucets": "🪞",
  "shower-systems": "🚿",
  "bath-mixers": "🛁",
  accessories: "🔩",
};

const categoryCounts: Record<string, number> = {
  all: 592,
  "kitchen-faucets": 110,
  "basin-faucets": 125,
  "shower-systems": 229,
  "bath-mixers": 76,
  accessories: 52,
};

const waBase = "https://wa.me/8617750519615";
const mailTo = "sending@sdnfaucet.com";
---

<MainLayout lang="zh" title="卫浴产品目录 | 592款全系列水龙头与淋浴系统批发直销" description="浏览泉州圣丹妮卫浴54页图册全量592款产品。每个产品实物图片、型号、出厂阶梯批发价、材质、表面工艺与MOQ参数直接呈现，一目了然。">
  <section class="section-padding !pt-8">
    <div class="container-tight">
      <!-- 页面头部 -->
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-ocean-50 px-3.5 py-1 text-xs font-semibold tracking-wide text-ocean-700">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          官方产品图册全量直观呈现 · 592 款型号图片与参数一目了然
        </span>
        <h1 class="heading-1 mt-3 !text-3xl sm:!text-4xl">产品目录</h1>
        <p class="mt-3 text-base text-gray-600 sm:text-lg">
          涵盖 5 个类别、21 个系列的 592 款产品 —— 每个产品均配实物图片、型号、表面颜色、材质、出厂阶梯批发价与起订量，无需多次点击，一览无余。
        </p>
      </div>

      <!-- 交互控制面板: 品类标签栏 + 实时搜索框 + 视图切换 -->
      <div class="mt-10 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
        <!-- 5 大品类筛选标签 -->
        <div class="flex flex-wrap items-center gap-2 border-b border-gray-100 pb-4" id="categoryNav">
          {
            ["all", "kitchen-faucets", "basin-faucets", "shower-systems", "bath-mixers", "accessories"].map((catKey) => {
              const count = categoryCounts[catKey] || 0;
              const isDefault = catKey === "all";
              return (
                <button
                  type="button"
                  class={`cat-tab-btn inline-flex items-center gap-1.5 rounded-xl px-3.5 py-2 text-xs sm:text-sm font-medium transition-all ${
                    isDefault
                      ? "bg-ocean-600 text-white shadow-sm ring-2 ring-ocean-600/20"
                      : "bg-gray-50 text-gray-700 hover:bg-gray-100"
                  }`}
                  data-cat={catKey}
                >
                  <span>{categoryIcons[catKey]}</span>
                  <span>{categoryLabels[catKey] || catKey}</span>
                  <span class={`rounded-full px-2 py-0.2 text-[11px] font-semibold ${isDefault ? "bg-white/20 text-white" : "bg-gray-200 text-gray-600"}`}>
                    {count}
                  </span>
                </button>
              );
            })
          }
        </div>

        <!-- 搜索与视图工具栏 -->
        <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="relative flex-1">
            <input
              type="text"
              id="productSearchInput"
              placeholder="输入型号 (如: 7200A, 1217, G153)、颜色、材质或功能特点实时检索..."
              class="w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 py-2.5 pl-10 text-sm transition-all focus:border-ocean-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-ocean-500/20"
            />
            <svg class="absolute left-3 top-3 h-4.5 w-4.5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <button id="clearSearchBtn" class="absolute right-3 top-2.5 hidden text-gray-400 hover:text-gray-600 text-sm font-medium">✕</button>
          </div>

          <!-- 统计计数与视图切换 -->
          <div class="flex items-center justify-between sm:justify-end gap-3">
            <div class="text-xs font-medium text-gray-500">
              匹配产品: <span id="filteredCountText" class="font-bold text-ocean-700">592</span> / 592 款
            </div>
            <div class="inline-flex rounded-lg border border-gray-200 bg-gray-50 p-0.5">
              <button id="btnViewGrid" class="rounded-md bg-white px-2.5 py-1 text-xs font-medium text-gray-900 shadow-xs" title="图文卡片视图">
                ▦ 卡片视图
              </button>
              <button id="btnViewTable" class="rounded-md px-2.5 py-1 text-xs font-medium text-gray-600 hover:text-gray-900" title="参数明细表">
                ▤ 明细表视图
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- 无搜索结果提示 -->
      <div id="noResultsAlert" class="mt-12 hidden rounded-2xl border border-dashed border-gray-300 p-12 text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-2xl">🔍</div>
        <h3 class="mt-4 text-base font-semibold text-gray-900">未找到匹配型号</h3>
        <p class="mt-1 text-sm text-gray-500">未找到符合条件的产品，请尝试不同搜索词或重置品类筛选。</p>
        <button id="resetFilterBtn" class="btn-secondary mt-4 !py-2 !text-xs">重置筛选条件</button>
      </div>

      <!-- 视图 1: 产品网格卡片流 (Grid View) —— 直接体现每个产品图片与核心参数 -->
      <div id="productGridContainer" class="mt-8 grid gap-5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {
          allCatalogItems.map((item, idx) => {
            const displayName = item.name_zh || item.name_en;
            const displaySeries = item.series_name_zh || item.series_name_en;
            const waText = `您好，SDN Faucet，我想咨询 ${item.model}（${item.finish}，${item.material}）的工厂批发报价，请分享价格、MOQ 和交期。`;
            const waHref = `${waBase}?text=${encodeURIComponent(waText)}`;
            const emailSub = `批发报价咨询: ${item.model} - ${displaySeries}`;
            const emailBody = `您好，SDN Faucet，\n\n我对贵司以下产品感兴趣：\n型号: ${item.model}\n归属系列: ${displaySeries}\n表面工艺: ${item.finish}\n材质: ${item.material}\n功能: ${item.features}\n\n请提供工厂出厂阶梯价、起订量（MOQ）以及样品寄送周期。\n\n谢谢。`;
            const mailHref = `mailto:${mailTo}?subject=${encodeURIComponent(emailSub)}&body=${encodeURIComponent(emailBody)}`;
            const seriesLink = `/zh/products/${item.series_id}`;

            return (
              <div
                class="product-card group flex flex-col rounded-2xl border border-gray-100 bg-white p-4 transition-all duration-200 hover:-translate-y-1 hover:border-ocean-200 hover:shadow-xl"
                data-index={idx}
                data-model={item.model.toLowerCase()}
                data-cat={item.category_id || "kitchen-faucets"}
                data-series={item.series_id || ""}
                data-search={`${item.model} ${item.finish} ${item.material} ${item.features} ${item.name_zh} ${item.name_en} ${item.series_name_zh}`.toLowerCase()}
              >
                <!-- 产品实物图片区域 -->
                <div class="relative mb-3 flex h-48 w-full items-center justify-center overflow-hidden rounded-xl bg-gray-50/70 p-3 group-hover:bg-ocean-50/30 transition-colors">
                  <img
                    src={item.image}
                    alt={`${item.model} - ${displayName}`}
                    loading="lazy"
                    class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-105"
                    onerror="this.onerror=null; this.src='https://sc02.alicdn.com/kf/A87f819b98dd94207818e182094f27463Q.png';"
                  />
                  <!-- 图册页码标识 -->
                  <span class="absolute top-2.5 right-2.5 rounded-md bg-white/90 px-1.5 py-0.5 text-[10px] font-mono font-medium text-gray-500 shadow-xs backdrop-blur-xs">
                    P.{item.page}
                  </span>
                </div>

                <!-- 系列标签 -->
                <div class="mb-1.5 flex items-center gap-1.5">
                  <a
                    href={seriesLink}
                    class="inline-block truncate text-[11px] font-semibold text-ocean-600 hover:text-ocean-700 hover:underline max-w-[200px]"
                    title={displaySeries}
                  >
                    {displaySeries}
                  </a>
                </div>

                <!-- 型号标题 -->
                <div class="flex items-baseline justify-between gap-1">
                  <h3 class="font-mono text-base font-bold text-gray-900 group-hover:text-ocean-600 transition-colors">
                    {item.model}
                  </h3>
                </div>

                <!-- 技术参数明细直接呈现 -->
                <div class="mt-2.5 space-y-1.5 border-t border-gray-50 pt-2.5 text-xs text-gray-600">
                  <div class="flex items-center justify-between">
                    <span class="text-gray-400">表面工艺:</span>
                    <span class="font-medium text-gray-800 text-right truncate max-w-[140px]" title={item.finish}>{item.finish || "铬色 / 多色可选"}</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-gray-400">主体材质:</span>
                    <span class="text-gray-700 text-right truncate max-w-[140px]" title={item.material}>{item.material || "304不锈钢 / 精铜"}</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-gray-400">出水功能:</span>
                    <span class="text-gray-700 text-right truncate max-w-[140px]" title={item.features}>{item.features || "出口标准级"}</span>
                  </div>
                  <div class="flex items-baseline justify-between border-t border-dashed border-gray-100 pt-1.5">
                    <span class="text-[11px] text-gray-400">出厂批发价:</span>
                    <span class="font-mono text-xs font-bold text-emerald-700 text-right truncate max-w-[150px]" title={item.prices}>
                      {item.prices || "询价获取"}
                    </span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-[11px] text-gray-400">起订量 MOQ:</span>
                    <span class="font-mono text-xs font-medium text-gray-700">{item.moq || "10"} 件</span>
                  </div>
                </div>

                <!-- 底部操作按钮 -->
                <div class="mt-auto pt-3.5 space-y-2">
                  <a
                    href={waHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex w-full items-center justify-center gap-1.5 rounded-xl border border-emerald-500 bg-emerald-50 py-2 text-xs font-semibold text-emerald-700 transition-colors hover:bg-emerald-100 hover:border-emerald-600"
                  >
                    <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                    </svg>
                    <span>获取批发报价</span>
                  </a>

                  <div class="grid grid-cols-2 gap-1.5">
                    <a
                      href={mailHref}
                      class="flex items-center justify-center gap-1 rounded-lg border border-gray-200 bg-gray-50 py-1.5 text-[11px] font-medium text-gray-700 hover:bg-gray-100"
                    >
                      ✉️ 邮件询价
                    </a>
                    <a
                      href={seriesLink}
                      class="flex items-center justify-center gap-1 rounded-lg border border-ocean-200 bg-ocean-50 py-1.5 text-[11px] font-medium text-ocean-700 hover:bg-ocean-100"
                    >
                      系列详情 →
                    </a>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>

      <!-- 视图 2: 产品表格明细流 (Table View) -->
      <div id="productTableContainer" class="mt-8 hidden overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 text-left text-sm">
            <thead class="bg-gray-50 text-xs font-semibold text-gray-600">
              <tr>
                <th scope="col" class="px-4 py-3.5">实物图片</th>
                <th scope="col" class="px-4 py-3.5">型号代码</th>
                <th scope="col" class="px-4 py-3.5">归属系列</th>
                <th scope="col" class="px-4 py-3.5">表面工艺</th>
                <th scope="col" class="px-4 py-3.5">材质标准</th>
                <th scope="col" class="px-4 py-3.5">出水功能</th>
                <th scope="col" class="px-4 py-3.5">出厂阶梯批发价</th>
                <th scope="col" class="px-4 py-3.5">MOQ</th>
                <th scope="col" class="px-4 py-3.5 text-right">一键询价</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white" id="productTableBody">
              {
                allCatalogItems.map((item) => {
                  const displaySeries = item.series_name_zh || item.series_name_en;
                  const waText = `您好，SDN Faucet，我想咨询 ${item.model}（${item.finish}，${item.material}）的工厂批发报价，请分享价格、MOQ 和交期。`;
                  const waLink = `${waBase}?text=${encodeURIComponent(waText)}`;
                  const seriesLink = `/zh/products/${item.series_id}`;

                  return (
                    <tr
                      class="product-table-row hover:bg-gray-50/80 transition-colors"
                      data-model={item.model.toLowerCase()}
                      data-cat={item.category_id || "kitchen-faucets"}
                      data-series={item.series_id || ""}
                      data-search={`${item.model} ${item.finish} ${item.material} ${item.features} ${item.name_zh} ${item.name_en} ${item.series_name_zh}`.toLowerCase()}
                    >
                      <td class="whitespace-nowrap px-4 py-3">
                        <img
                          src={item.image}
                          alt={item.model}
                          loading="lazy"
                          class="h-14 w-14 rounded-lg object-contain bg-gray-50 p-1 border border-gray-100"
                          onerror="this.onerror=null; this.src='https://sc02.alicdn.com/kf/A87f819b98dd94207818e182094f27463Q.png';"
                        />
                      </td>
                      <td class="whitespace-nowrap px-4 py-3 font-mono font-bold text-gray-900">
                        {item.model}
                      </td>
                      <td class="px-4 py-3 text-xs">
                        <a href={seriesLink} class="font-medium text-ocean-600 hover:underline block max-w-xs truncate" title={displaySeries}>
                          {displaySeries}
                        </a>
                        <span class="text-gray-400">P.{item.page}</span>
                      </td>
                      <td class="px-4 py-3 text-xs font-medium text-gray-800">
                        {item.finish || "Chrome"}
                      </td>
                      <td class="px-4 py-3 text-xs text-gray-600">
                        {item.material || "304 Stainless / Brass"}
                      </td>
                      <td class="px-4 py-3 text-xs text-gray-600 max-w-xs truncate" title={item.features}>
                        {item.features || "标准出厂级"}
                      </td>
                      <td class="px-4 py-3 text-xs font-mono font-semibold text-emerald-700">
                        {item.prices || "询价获取"}
                      </td>
                      <td class="whitespace-nowrap px-4 py-3 font-mono text-xs text-gray-600">
                        {item.moq || "10"} 件
                      </td>
                      <td class="whitespace-nowrap px-4 py-3 text-right">
                        <a
                          href={waLink}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1 rounded-lg border border-emerald-500 bg-emerald-50 px-2.5 py-1.5 text-xs font-semibold text-emerald-700 hover:bg-emerald-100"
                        >
                          WhatsApp 报价
                        </a>
                      </td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
      </div>

      <!-- 分页控制栏 (Pagination Controls) -->
      <div id="paginationBar" class="mt-10 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-gray-100 pt-6">
        <div class="text-xs text-gray-500">
          <span id="pageInfoText">第 1 页 / 共 15 页</span>
        </div>
        <div class="flex items-center gap-2">
          <button id="btnPrevPage" class="rounded-xl border border-gray-200 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50 disabled:opacity-40 disabled:pointer-events-none">
            ← 上一页
          </button>
          <div id="pageNumbersContainer" class="flex items-center gap-1"></div>
          <button id="btnNextPage" class="rounded-xl border border-gray-200 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50 disabled:opacity-40 disabled:pointer-events-none">
            下一页 →
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- 客户端交互脚本：高效即时搜索、分类切换、视图切换与分页联动 -->
  <script is:inline>
    (function () {
      const searchInput = document.getElementById("productSearchInput");
      const clearSearchBtn = document.getElementById("clearSearchBtn");
      const catButtons = document.querySelectorAll(".cat-tab-btn");
      const filteredCountText = document.getElementById("filteredCountText");
      const noResultsAlert = document.getElementById("noResultsAlert");
      const resetFilterBtn = document.getElementById("resetFilterBtn");
      const gridContainer = document.getElementById("productGridContainer");
      const tableContainer = document.getElementById("productTableContainer");
      const btnViewGrid = document.getElementById("btnViewGrid");
      const btnViewTable = document.getElementById("btnViewTable");

      const btnPrevPage = document.getElementById("btnPrevPage");
      const btnNextPage = document.getElementById("btnNextPage");
      const pageInfoText = document.getElementById("pageInfoText");
      const pageNumbersContainer = document.getElementById("pageNumbersContainer");
      const paginationBar = document.getElementById("paginationBar");

      const cards = Array.from(document.querySelectorAll(".product-card"));
      const tableRows = Array.from(document.querySelectorAll(".product-table-row"));

      const PAGE_SIZE = 40; // 每页展示 40 款，浏览丝滑不卡顿
      let currentPage = 1;
      let activeCat = "all";
      let searchKeyword = "";
      let isTableView = false;

      let matchingIndices = cards.map((_, i) => i);

      function updateFiltering() {
        matchingIndices = [];
        for (let i = 0; i < cards.length; i++) {
          const card = cards[i];
          const rowCat = card.getAttribute("data-cat");
          const searchData = card.getAttribute("data-search") || "";

          const matchesCat = activeCat === "all" || rowCat === activeCat;
          const matchesSearch = !searchKeyword || searchData.includes(searchKeyword);

          if (matchesCat && matchesSearch) {
            matchingIndices.push(i);
          }
        }

        currentPage = 1;
        renderCurrentPage();
      }

      function renderCurrentPage() {
        const totalMatching = matchingIndices.length;
        if (filteredCountText) filteredCountText.textContent = totalMatching;

        if (totalMatching === 0) {
          if (gridContainer) gridContainer.classList.add("hidden");
          if (tableContainer) tableContainer.classList.add("hidden");
          if (paginationBar) paginationBar.classList.add("hidden");
          if (noResultsAlert) noResultsAlert.classList.remove("hidden");
          return;
        }

        if (noResultsAlert) noResultsAlert.classList.add("hidden");
        if (paginationBar) paginationBar.classList.remove("hidden");

        if (isTableView) {
          if (gridContainer) gridContainer.classList.add("hidden");
          if (tableContainer) tableContainer.classList.remove("hidden");
        } else {
          if (gridContainer) gridContainer.classList.remove("hidden");
          if (tableContainer) tableContainer.classList.add("hidden");
        }

        const totalPages = Math.ceil(totalMatching / PAGE_SIZE);
        const startIndex = (currentPage - 1) * PAGE_SIZE;
        const endIndex = Math.min(startIndex + PAGE_SIZE, totalMatching);
        const activePageIndices = new Set(matchingIndices.slice(startIndex, endIndex));

        // 仅显示当前页项目
        for (let i = 0; i < cards.length; i++) {
          const isVisible = activePageIndices.has(i);
          cards[i].style.display = isVisible ? "" : "none";
          if (tableRows[i]) tableRows[i].style.display = isVisible ? "" : "none";
        }

        // 更新分页栏
        if (pageInfoText) {
          pageInfoText.textContent = `第 ${currentPage} 页 / 共 ${totalPages} 页 (展示第 ${startIndex + 1}-${endIndex} 款)`;
        }

        if (btnPrevPage) btnPrevPage.disabled = currentPage <= 1;
        if (btnNextPage) btnNextPage.disabled = currentPage >= totalPages;

        renderPageNumbers(totalPages);
      }

      function renderPageNumbers(totalPages) {
        if (!pageNumbersContainer) return;
        pageNumbersContainer.innerHTML = "";

        const maxButtons = 5;
        let startP = Math.max(1, currentPage - 2);
        let endP = Math.min(totalPages, startP + maxButtons - 1);
        if (endP - startP < maxButtons - 1) {
          startP = Math.max(1, endP - maxButtons + 1);
        }

        for (let p = startP; p <= endP; p++) {
          const btn = document.createElement("button");
          btn.textContent = p;
          btn.className = `h-8 w-8 rounded-lg text-xs font-semibold transition-all ${
            p === currentPage
              ? "bg-ocean-600 text-white shadow-xs"
              : "bg-white text-gray-700 hover:bg-gray-100 border border-gray-200"
          }`;
          btn.addEventListener("click", () => {
            currentPage = p;
            renderCurrentPage();
            window.scrollTo({ top: 380, behavior: "smooth" });
          });
          pageNumbersContainer.appendChild(btn);
        }
      }

      if (btnPrevPage) {
        btnPrevPage.addEventListener("click", () => {
          if (currentPage > 1) {
            currentPage--;
            renderCurrentPage();
            window.scrollTo({ top: 380, behavior: "smooth" });
          }
        });
      }

      if (btnNextPage) {
        btnNextPage.addEventListener("click", () => {
          const totalPages = Math.ceil(matchingIndices.length / PAGE_SIZE);
          if (currentPage < totalPages) {
            currentPage++;
            renderCurrentPage();
            window.scrollTo({ top: 380, behavior: "smooth" });
          }
        });
      }

      if (searchInput) {
        searchInput.addEventListener("input", (e) => {
          searchKeyword = e.target.value.toLowerCase().trim();
          if (clearSearchBtn) {
            clearSearchBtn.classList.toggle("hidden", searchKeyword.length === 0);
          }
          updateFiltering();
        });
      }

      if (clearSearchBtn) {
        clearSearchBtn.addEventListener("click", () => {
          if (searchInput) searchInput.value = "";
          searchKeyword = "";
          clearSearchBtn.classList.add("hidden");
          updateFiltering();
        });
      }

      catButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          catButtons.forEach((b) => {
            b.classList.remove("bg-ocean-600", "text-white", "shadow-sm", "ring-2", "ring-ocean-600/20");
            b.classList.add("bg-gray-50", "text-gray-700");
            const badge = b.querySelector("span:last-child");
            if (badge) {
              badge.classList.remove("bg-white/20", "text-white");
              badge.classList.add("bg-gray-200", "text-gray-600");
            }
          });

          btn.classList.add("bg-ocean-600", "text-white", "shadow-sm", "ring-2", "ring-ocean-600/20");
          btn.classList.remove("bg-gray-50", "text-gray-700");
          const activeBadge = btn.querySelector("span:last-child");
          if (activeBadge) {
            activeBadge.classList.add("bg-white/20", "text-white");
            activeBadge.classList.remove("bg-gray-200", "text-gray-600");
          }

          activeCat = btn.getAttribute("data-cat") || "all";
          updateFiltering();
        });
      });

      if (resetFilterBtn) {
        resetFilterBtn.addEventListener("click", () => {
          if (searchInput) searchInput.value = "";
          searchKeyword = "";
          if (clearSearchBtn) clearSearchBtn.classList.add("hidden");
          const allBtn = document.querySelector('.cat-tab-btn[data-cat="all"]');
          if (allBtn) allBtn.click();
        });
      }

      if (btnViewGrid && btnViewTable) {
        btnViewGrid.addEventListener("click", () => {
          isTableView = false;
          btnViewGrid.classList.add("bg-white", "text-gray-900", "shadow-xs");
          btnViewGrid.classList.remove("text-gray-600");
          btnViewTable.classList.remove("bg-white", "text-gray-900", "shadow-xs");
          btnViewTable.classList.add("text-gray-600");
          renderCurrentPage();
        });

        btnViewTable.addEventListener("click", () => {
          isTableView = true;
          btnViewTable.classList.add("bg-white", "text-gray-900", "shadow-xs");
          btnViewTable.classList.remove("text-gray-600");
          btnViewGrid.classList.remove("bg-white", "text-gray-900", "shadow-xs");
          btnViewGrid.classList.add("text-gray-600");
          renderCurrentPage();
        });
      }

      updateFiltering();
    })();
  </script>
</MainLayout>
