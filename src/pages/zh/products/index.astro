---
import { getCollection } from "astro:content";
import MainLayout from "@layouts/MainLayout.astro";

const products = await getCollection("products");

const categoryLabels: Record<string, string> = {
  "kitchen-faucets": "厨房水龙头",
  "basin-faucets": "面盆龙头",
  "shower-systems": "淋浴系统",
  "bath-mixers": "浴缸混水龙头",
  accessories: "卫浴配件",
};

const categoryIcons: Record<string, string> = {
  "kitchen-faucets": "🚰",
  "basin-faucets": "🪞",
  "shower-systems": "🚿",
  "bath-mixers": "🛁",
  accessories: "🔩",
};
const productNameLabels: Record<string, string> = {
  "sdn-6317-waterfall-basin": "SDN-6317 瀑布式面盆龙头",
  "sdn-7200-kitchen-faucet": "SDN-7200 厨房水龙头",
  "sdn-904-shower-head": "SDN-904 / 905 顶喷淋浴花洒",
  "sdn-accessories": "卫浴配件",
  "sdn-bath-mixer": "SDN-BM01 浴缸淋浴混水龙头套装",
  "sdn-g153-basin-faucet": "SDN-G153 面盆龙头",
};

const finishLabels: Record<string, string> = {
  "Black / Chrome / White / Brushed Gold": "黑色 / 镀铬 / 白色 / 拉丝金",
  "Chrome / Brushed Nickel / Matte Black": "镀铬 / 拉丝镍 / 哑光黑",
  "Chrome / Matte Black": "镀铬 / 哑光黑",
  "Chrome / Various": "镀铬 / 多种可选",
  "Chrome / Brushed Nickel": "镀铬 / 拉丝镍",
  "Chrome / Brushed Nickel / Brushed Gold": "镀铬 / 拉丝镍 / 拉丝金",
};
---

<MainLayout
  lang="zh"
  title="卫浴产品目录 | 批发厨房水龙头与豪华淋浴系统"
  description="浏览SDN Faucet完整B2B产品目录。商用厨房混水龙头与豪华顶喷淋浴系统，工厂直销价格。"
>
  <section class="section-padding">
    <div class="container-tight">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="heading-1">产品目录</h1>
        <p class="mt-4 text-lg text-gray-500">
          {products.length} 款产品，覆盖 {Object.keys(categoryLabels).length} 大品类 —— 欢迎B2B询价
        </p>
      </div>

      <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          products.map((product) => {
            const { title, model, category, specs } = product.data;
            const slug = product.slug;
            return (
              <a
                href={`/zh/products/${slug}`}
                class="group flex flex-col rounded-xl border border-gray-100 bg-white p-6 transition-all duration-200 hover:border-ocean-200 hover:shadow-lg"
              >
                <div class="flex items-center gap-2">
                  <span class="text-2xl">{categoryIcons[category] || "📦"}</span>
                  <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-500">
                    {categoryLabels[category] || category}
                  </span>
                </div>
                <h3 class="mt-3 text-lg font-semibold text-gray-900 group-hover:text-ocean-600">
                  {productNameLabels[slug] || title}
                </h3>
                <p class="mt-1 font-mono text-sm text-ocean-600">{model}</p>
                {
                  specs?.finish && (
                    <p class="mt-2 text-sm text-gray-500">{finishLabels[specs.finish] || specs.finish}</p>
                  )
                }
                <div class="mt-auto pt-4">
                  <span class="inline-flex items-center gap-1 text-sm font-medium text-ocean-600 group-hover:gap-2 transition-all">
                    查看详情并询价
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</MainLayout>
