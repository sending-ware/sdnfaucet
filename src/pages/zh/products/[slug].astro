---
import { getCollection } from "astro:content";
import MainLayout from "@layouts/MainLayout.astro";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await product.render();

const specLabels: Record<string, string> = {
  material: "材质",
  finish: "表面处理",
  type: "类型",
  features: "特点",
};
---

<MainLayout
  lang="zh"
  title={`${product.data.title} | SDN Faucet`}
  description={product.data.description || `探索SDN Faucet ${product.data.title}。专业卫浴品质。`}
  image={product.data.image}
>
  <section class="section-padding bg-white">
    <div class="container-tight px-4">
      <!-- 面包屑导航 -->
      <nav class="mb-8 text-sm text-gray-500">
        <a href="/zh/" class="hover:text-ocean-600">首页</a>
        <span class="mx-2">/</span>
        <a href="/zh/products" class="hover:text-ocean-600">产品中心</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900">{product.data.title}</span>
      </nav>

      <div class="grid gap-12 lg:grid-cols-2">
        <!-- 产品图片 -->
        <div class="space-y-6">
          <figure class="overflow-hidden rounded-xl border border-gray-100 bg-white p-4">
            <img
              src={product.data.image}
              alt={`${product.data.title} - 实景展示`}
              class="w-full h-auto object-contain"
              loading="eager"
            />
            <figcaption class="mt-3 text-center text-xs font-medium uppercase tracking-widest text-gray-400">
              实景展示
            </figcaption>
          </figure>

          {product.data.tech_image && (
            <figure class="overflow-hidden rounded-xl border border-gray-100 bg-white p-4">
              <img
                src={product.data.tech_image}
                alt={`${product.data.title} - 技术图`}
                class="w-full h-auto object-contain"
                loading="lazy"
              />
              <figcaption class="mt-3 text-center text-xs font-medium uppercase tracking-widest text-gray-400">
                技术图 / 卖点
              </figcaption>
            </figure>
          )}
        </div>

        <!-- 产品信息 -->
        <div>
          <h1 class="heading-2">{product.data.title}</h1>
          <p class="mt-2 text-sm font-medium text-ocean-600 uppercase tracking-wider">
            型号：{product.data.model}
          </p>

          <div class="mt-8 space-y-6">
            <div class="rounded-xl bg-gray-50 p-6">
              <h2 class="text-sm font-bold uppercase tracking-wider text-gray-900">关键规格</h2>
              <dl class="mt-4 grid grid-cols-1 gap-x-4 gap-y-3 sm:grid-cols-2">
                {Object.entries(product.data.specs).map(([key, value]) => (
                  <div>
                    <dt class="text-xs font-medium text-gray-400 uppercase">{specLabels[key] || key}</dt>
                    <dd class="mt-1 text-sm font-semibold text-gray-900">
                      {Array.isArray(value) ? value.join("、") : value}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>

            <div class="prose prose-sm prose-ocean max-w-none">
              <Content />
            </div>

            <div class="pt-8">
              <a
                href="/zh/contact"
                class="btn-primary w-full justify-center py-4 text-lg"
              >
                获取批发价格询价
              </a>
              <p class="mt-4 text-center text-xs text-gray-400">
                ✓ 工厂直销  ✓ 24小时响应  ✓ OEM/ODM支持
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
