---
import { getCollection } from "astro:content";
import MainLayout from "@layouts/MainLayout.astro";

const products = await getCollection("products");

const categoryLabels: Record<string, string> = {
  "kitchen-faucets": "خلاطات المطبخ",
  "basin-faucets": "خلاطات الأحواض",
  "shower-systems": "أنظمة الدش",
  "bath-mixers": "خلاطات الحمام",
  accessories: "الملحقات",
};

const categoryIcons: Record<string, string> = {
  "kitchen-faucets": "🚰",
  "basin-faucets": "🪞",
  "shower-systems": "🚿",
  "bath-mixers": "🛁",
  accessories: "🔩",
};
const productNameLabels: Record<string, string> = {
  "sdn-6317-waterfall-basin": "خلاط حوض شلال SDN-6317",
  "sdn-7200-kitchen-faucet": "خلاط مطبخ SDN-7200",
  "sdn-904-shower-head": "دش سقفي مطري SDN-904 / 905",
  "sdn-accessories": "مستلزمات صحية",
  "sdn-bath-mixer": "طقم خلاط حوض استحمام SDN-BM01",
  "sdn-g153-basin-faucet": "خلاط حوض SDN-G153",
};

const finishLabels: Record<string, string> = {
  "Black / Chrome / White / Brushed Gold": "أسود / كروم / أبيض / ذهبي مصقول",
  "Chrome / Brushed Nickel / Matte Black": "كروم / نيكل مصقول / أسود مطفي",
  "Chrome / Matte Black": "كروم / أسود مطفي",
  "Chrome / Various": "كروم / متعدد",
  "Chrome / Brushed Nickel": "كروم / نيكل مصقول",
  "Chrome / Brushed Nickel / Brushed Gold": "كروم / نيكل مصقول / ذهبي مصقول",
};
---

<MainLayout
  lang="ar"
  title="كتالوج الأدوات الصحية B2B | خلاطات مطبخ بالجملة ودشات فاخرة"
  description="استكشف كتالوج SDN Faucet الكامل للبيع بالجملة B2B. أسعار مباشرة من المصنع لخلاطات المطبخ ودشات الأمطار الفاخرة."
>
  <section class="section-padding">
    <div class="container-tight">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="heading-1">كتالوج المنتجات</h1>
        <p class="mt-4 text-lg text-gray-500">
          {products.length} منتجات في {Object.keys(categoryLabels).length} فئات — جاهزة لاستفسارات B2B
        </p>
      </div>

      <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          products.map((product) => {
            const { title, model, category, specs } = product.data;
            const slug = product.slug;
            return (
              <a
                href={`/ar/products/${slug}`}
                class="group flex flex-col rounded-xl border border-gray-100 bg-white p-6 transition-all duration-200 hover:border-ocean-200 hover:shadow-lg"
              >
                <div class="flex items-center gap-2">
                  <span class="text-2xl">{categoryIcons[category] || "📦"}</span>
                  <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-500">
                    {categoryLabels[category] || category}
                  </span>
                </div>
                <h3 class="mt-3 text-lg font-semibold text-gray-900 group-hover:text-ocean-600">
                  {productNameLabels[slug] || title}
                </h3>
                <p class="mt-1 font-mono text-sm text-ocean-600">{model}</p>
                {
                  specs?.finish && (
                    <p class="mt-2 text-sm text-gray-500">{finishLabels[specs.finish] || specs.finish}</p>
                  )
                }
                <div class="mt-auto pt-4">
                  <span class="inline-flex items-center gap-1 text-sm font-medium text-ocean-600 group-hover:gap-2 transition-all">
                    عرض التفاصيل والاستفسار
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</MainLayout>
