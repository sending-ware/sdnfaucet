---
import MainLayout from "@layouts/MainLayout.astro";
import QuickInquiry from "@components/inquiry/QuickInquiry";

const inquiryLabels = {
  name: "الاسم",
  namePlaceholder: "اسمك الكامل",
  email: "البريد الإلكتروني",
  emailPlaceholder: "your@company.com",
  company: "الشركة",
  companyPlaceholder: "شركتك",
  quantity: "الكمية (تقريبية)",
  quantityPlaceholder: "مثلاً 500 قطعة",
  message: "المتطلبات",
  messagePlaceholder: "أخبرنا عن: السوق المستهدف، تفضيلات التشطيب، احتياجات OEM، متطلبات التعبئة والتغليف...",
  submit: "أرسل الاستفسار الآن",
  submitting: "جاري الإرسال...",
  successTitle: "تم إرسال الاستفسار بنجاح!",
  successText: "سنقوم بمراجعة متطلباتك والرد خلال 24 ساعة.",
  errorText: "فشل الإرسال. يرجى المحاولة مرة أخرى أو مراسلتنا مباشرة على sending@sdnfaucet.com",
  emailFailedText: "تم حفظ استفسارك، لكن فشل إرسال البريد الإلكتروني. يرجى التواصل معنا عبر واتساب أو البريد الإلكتروني.",
  retry: "إعادة التحقق",
  privacy: "محمي بواسطة Turnstile. تُستخدم معلوماتك فقط للرد على هذا الاستفسار.",
  errorNameRequired: "الاسم مطلوب",
  errorEmailRequired: "البريد الإلكتروني مطلوب",
  errorEmailInvalid: "يرجى إدخال بريد إلكتروني صحيح",
  errorMessageRequired: "يرجى وصف متطلباتك",
};
---

<MainLayout
  lang="ar"
  title="اتصل بنا واستفسر | SDN Faucet"
  description="تواصل مع SDN Faucet للأدوات الصحية عالية الجودة للمطبخ والحمام. نقدم خدمات OEM/ODM احترافية وأسعارًا مباشرة من المصنع."
>
  <section class="section-padding bg-white">
    <div class="container-tight px-4">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="heading-1">تواصل معنا</h1>
        <p class="mt-4 text-gray-500">
          أخبرنا بمتطلبات منتجك وسنرد عليك خلال 24 ساعة.
        </p>
      </div>

      <div class="mt-12">
        <QuickInquiry client:load lang="ar" labels={inquiryLabels} />
      </div>

      <div class="mt-20 rounded-2xl bg-gray-50 p-8 sm:p-12">
        <h2 class="text-2xl font-bold text-gray-900">طرق أخرى للتواصل معنا</h2>
        <div class="mt-4 space-y-4 text-sm text-gray-500">
          <p>
            <strong>البريد الإلكتروني:</strong>
            <a href="mailto:sending@sdnfaucet.com" class="text-ocean-600 hover:underline">sending@sdnfaucet.com</a>
          </p>
          <p>
            <strong>الهاتف/واتساب:</strong>
            <a href="tel:+8613064536291" class="text-ocean-600 hover:underline">+86 13064536291</a> /
            <a href="tel:+8617750519615" class="text-ocean-600 hover:underline">+86 17750519615</a>
          </p>
          <p>
            <strong>العنوان:</strong> الغرفة 501، مبنى 1، مجمع ديفا التقني، بلدة تشنغشيانغ، مقاطعة آنشي، مدينة تشيوانتشو، مقاطعة فوجيان، الصين
          </p>
          <p>
            <strong>وقت الرد:</strong> خلال 24 ساعة في أيام العمل
          </p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
