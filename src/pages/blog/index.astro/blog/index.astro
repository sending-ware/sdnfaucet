---
import { getCollection } from "astro:content";
import MainLayout from "@layouts/MainLayout.astro";

const posts = await getCollection("blog", ({ id }) => {
  return id.startsWith("en/");
});
---

<MainLayout
  title="Technical Encyclopedia & Industry Insights | SDN Faucet"
  description="Explore professional technical articles from SDN Faucet, covering SUS304 stainless steel standards, bathroom industry trends, and maintenance tips."
>
  <section class="section-padding bg-gray-50">
    <div class="container-tight px-4">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="heading-1">Technical Encyclopedia</h1>
        <p class="mt-4 text-lg text-gray-500">
          Sharing factory expertise and deep insights into the sanitary ware industry
        </p>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a href={`/blog/${post.slug.replace("en/", "")}`} class="group flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm transition-all hover:shadow-xl hover:-translate-y-1 border border-gray-100">
            <div class="aspect-video overflow-hidden">
              <img src={post.data.image} alt={post.data.title} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h2 class="text-xl font-bold text-gray-900 group-hover:text-ocean-600 line-clamp-2">{post.data.title}</h2>
              <p class="mt-3 text-sm text-gray-500 line-clamp-3">{post.data.description}</p>
              <div class="mt-auto pt-6 text-sm font-medium text-ocean-600 flex items-center gap-2">
                Read More
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</MainLayout>

