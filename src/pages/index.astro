---
import MainLayout from "@layouts/MainLayout.astro";
---

<MainLayout
  title="Professional Sanitary Ware Manufacturer"
  description="SDN Faucet - Quanzhou-based sanitary ware manufacturer specializing in kitchen faucets, basin faucets, shower systems and bathroom accessories for global B2B buyers."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-br from-ocean-50 via-white to-blue-50">
    <div class="container-tight px-4 pb-16 pt-20 sm:px-6 sm:pb-24 sm:pt-28 lg:px-8 lg:pb-32 lg:pt-36">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-block rounded-full bg-ocean-100 px-4 py-1.5 text-xs font-semibold tracking-wide text-ocean-700">
          B2B SANITARY WARE MANUFACTURER
        </span>
        <h1 class="mt-6 heading-1 animate-fade-in">
          Premium Faucets &amp; Sanitary Ware
          <span class="block text-ocean-600">From Quanzhou to Global Markets</span>
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-gray-500 animate-slide-up">
          With years of manufacturing expertise in southern China's sanitary ware hub,
          we deliver kitchen faucets, basin mixers, shower systems, and bathroom
          accessories that meet international quality standards.
        </p>
        <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center animate-slide-up">
          <a href="/products" class="btn-primary min-w-[180px]">
            View Products
          </a>
          <a href="/contact" class="btn-secondary min-w-[180px]">
            Request Quote
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Product Categories -->
  <section class="section-padding bg-white">
    <div class="container-tight">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="heading-2">Product Categories</h2>
        <p class="mt-4 text-gray-500">
          From kitchen to bathroom — complete sanitary ware solutions for importers, distributors, and project buyers.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          [
            { icon: "🚰", title: "Kitchen Faucets", desc: "Pull-out, pull-down & 360° rotation series in 304 stainless steel and brass." },
            { icon: "🪞", title: "Basin Faucets", desc: "Hot & cold mixers, waterfall designs, wall-mounted options for modern bathrooms." },
            { icon: "🚿", title: "Shower Systems", desc: "Overhead showers, handheld sprays, ABS and stainless steel combinations." },
            { icon: "🛁", title: "Bath Mixers", desc: "Bath shower mixers and bidet sprayer sets for complete bathroom packages." },
            { icon: "🔩", title: "Accessories", desc: "Angle valves, soap dispensers, replacement parts for one-stop procurement." },
            { icon: "🏭", title: "OEM / ODM", desc: "Custom design, finish, and packaging to match your brand requirements." },
          ].map((cat) => (
            <a
              href="/products"
              class="group rounded-xl border border-gray-100 bg-white p-6 transition-all duration-200 hover:border-ocean-200 hover:shadow-lg"
            >
              <span class="text-3xl">{cat.icon}</span>
              <h3 class="mt-4 heading-3">{cat.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-gray-500">
                {cat.desc}
              </p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-ocean-600 group-hover:gap-2 transition-all">
                Learn more
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why Us -->
  <section class="section-padding bg-gray-50">
    <div class="container-tight">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="heading-2">Why Source From SDN</h2>
        <p class="mt-4 text-gray-500">
          We make B2B sanitary ware procurement reliable and efficient.
        </p>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            { title: "Direct Factory", desc: "Eliminate middlemen — competitive pricing with factory-direct quality control." },
            { title: "Export Ready", desc: "International packaging, labeling, and documentation for global shipping." },
            { title: "Quality Tested", desc: "Every product undergoes pressure, finish, and function testing before dispatch." },
            { title: "Flexible MOQ", desc: "Support trial orders and mixed containers for new partnerships." },
          ].map((item) => (
            <div class="rounded-xl bg-white p-6 text-center">
              <h3 class="heading-3">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-gray-500">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding bg-ocean-600">
    <div class="container-tight text-center">
      <h2 class="heading-2 text-white">Ready to Start Sourcing?</h2>
      <p class="mt-4 mx-auto max-w-xl text-ocean-100">
        Tell us your product requirements, target market, and order volume.
        We'll respond with pricing and samples within 24 hours.
      </p>
      <a href="/contact" class="mt-8 inline-block rounded-lg bg-white px-8 py-4 text-sm font-semibold text-ocean-700 transition-all duration-200 hover:bg-ocean-50">
        Send Inquiry Now →
      </a>
    </div>
  </section>
</MainLayout>
