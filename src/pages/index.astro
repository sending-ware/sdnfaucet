---
import MainLayout from "@layouts/MainLayout.astro";
---


<MainLayout
  title="SDN Faucet | Professional Sanitary Ware Manufacturer & B2B Wholesale Supplier"
  description="SDN Faucet is a premier sanitary ware manufacturer from Quanzhou, China. We supply high-quality kitchen faucets, basin mixers, and shower systems for global B2B distributors."
>
  <!-- Hero Section -->
    <!-- Hero Section -->
  <section class="relative overflow-hidden bg-cover bg-no-repeat py-20 sm:py-32" style="background-image: linear-gradient(rgba(255,255,255,0.85), rgba(255,255,255,0.85)), url('https://sc02.alicdn.com/kf/Af26bc4625fb345588d112662bb13cd09u.png'); background-position: center 25%;">
    <div class="container-tight px-4 pb-16 pt-20 sm:px-6 sm:pb-24 sm:pt-28 lg:px-8 lg:pb-32 lg:pt-36">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-block rounded-full bg-ocean-100 px-4 py-1.5 text-xs font-semibold tracking-wide text-ocean-700">
          B2B SANITARY WARE MANUFACTURER
        </span>
        <h1 class="mt-6 heading-1 animate-fade-in">
          Premium Faucets &amp; Sanitary Ware
          <span class="block text-ocean-600">From Quanzhou to Global Markets</span>
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-gray-500 animate-slide-up">
          With years of manufacturing expertise in southern China's sanitary ware hub,
          we deliver kitchen faucets, basin mixers, shower systems, and bathroom
          accessories that meet international quality standards.
        </p>
        <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center animate-slide-up">
          <a href="/products" class="btn-primary min-w-[180px]">
            View Products
          </a>
          <a href="/sdn_faucet_2026_catalog.pdf" target="_blank" class="btn-secondary min-w-[180px] flex items-center justify-center gap-2">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a2 2 0 002 2h10a2 2 0 002-2v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            Download Catalog
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- Product Categories -->
  <section class="section-padding bg-white">
    <div class="container-tight">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="heading-2">Product Categories</h2>
        <p class="mt-4 text-gray-500">
          From kitchen to bathroom — complete sanitary ware solutions for importers, distributors, and project buyers.
        </p>
      </div>


      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          [
            { image: "https://sc02.alicdn.com/kf/A4723dd488c8f4eaeab11c27cf1096ff6t.png", title: "Kitchen Faucets", desc: "Pull-out, pull-down & 360° rotation series in 304 stainless steel and brass." },
            { image: "https://sc02.alicdn.com/kf/Ab516d8e6b6484898887800b17e10e100l.png", title: "Basin Faucets", desc: "Hot & cold mixers, waterfall designs, wall-mounted options for modern bathrooms." },
            { image: "https://sc02.alicdn.com/kf/Ac2a9ba1f20fb4e8f9527ada5cd48b9f8I.png", title: "Shower Systems", desc: "Overhead showers, handheld sprays, ABS and stainless steel combinations." },
            { image: "https://sc02.alicdn.com/kf/A77b9956cbf3844208835d4e9e2d379a0e.png", title: "Bath Mixers", desc: "Bath shower mixers and bidet sprayer sets for complete bathroom packages." },
            { image: "https://sc02.alicdn.com/kf/A6fa1adbd0d9f48078c469b08b8516295y.png", title: "Accessories", desc: "Angle valves, soap dispensers, replacement parts for one-stop procurement." },
            { image: "https://sc02.alicdn.com/kf/Af26bc4625fb345588d112662bb13cd09u.png", title: "OEM / ODM", desc: "Custom design, finish, and packaging to match your brand requirements." },
          ].map((cat) => (
            <a
              href="/products"
              class="group rounded-xl border border-gray-100 bg-white p-6 transition-all duration-200 hover:border-ocean-200 hover:shadow-lg"
            >
              <div class="overflow-hidden bg-gray-50/50">
                <img src={cat.image} alt={cat.title} class="aspect-[16/9] w-full object-contain p-4 transition-transform duration-300 group-hover:scale-105" loading="lazy" />
              </div>
              <h3 class="mt-4 heading-3">{cat.title}</h3>
              <p class="mt-2 text-sm text-gray-500">{cat.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
    <!-- Why SDN Faucet -->
    <section class="section-padding bg-gray-50">
      <div class="container-tight px-4">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="heading-2">Why Choose SDN Faucet</h2>
          <p class="mt-4 text-gray-500">A reliable factory partner for importers, wholesalers, and project buyers worldwide.</p>
        </div>
        <div class="mt-12 grid gap-8 lg:grid-cols-2 lg:items-stretch">
          <div>
            <img src="https://sc02.alicdn.com/kf/A085f47d0bc0b43f5a0b088e0504c8d4f0.png" alt="SDN Faucet factory showroom" class="h-full min-h-[240px] w-full rounded-2xl object-cover shadow-sm" loading="lazy" />
          </div>
          <div class="rounded-2xl border border-gray-100 bg-white p-6 sm:p-8">
            <h3 class="text-xl font-bold text-gray-900">More than a supplier — a long-term factory partner</h3>
            <p class="mt-3 leading-relaxed text-gray-500">From material selection and quality control to OEM/ODM packaging, we help global partners source and deliver sanitary ware with confidence.</p>
            <div class="mt-8 grid grid-cols-2 gap-4">
              <div class="rounded-xl bg-ocean-50 p-4"><strong class="block text-2xl text-ocean-700">304</strong><span class="mt-1 block text-sm text-gray-600">Stainless steel series</span></div>
              <div class="rounded-xl bg-ocean-50 p-4"><strong class="block text-2xl text-ocean-700">500,000+</strong><span class="mt-1 block text-sm text-gray-600">Cartridge cycle tests</span></div>
              <div class="rounded-xl bg-ocean-50 p-4"><strong class="block text-2xl text-ocean-700">OEM</strong><span class="mt-1 block text-sm text-gray-600">Brand customization</span></div>
              <div class="rounded-xl bg-ocean-50 p-4"><strong class="block text-2xl text-ocean-700">24h</strong><span class="mt-1 block text-sm text-gray-600">Workday response</span></div>
            </div>
            <div class="mt-5 flex flex-wrap gap-2 text-sm text-ocean-700"><span class="rounded-full border border-ocean-100 bg-ocean-50 px-3 py-1">Production workshop</span><span class="rounded-full border border-ocean-100 bg-ocean-50 px-3 py-1">OEM / ODM</span><span class="rounded-full border border-ocean-100 bg-ocean-50 px-3 py-1">Mixed-container shipping</span><span class="rounded-full border border-ocean-100 bg-ocean-50 px-3 py-1">ISO / CE standards</span></div>
          </div>
        </div>
      </div>
    </section>
  </MainLayout>
