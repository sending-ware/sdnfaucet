---
import "@/styles/global.css";

export interface Props {
  title: string;
  description: string;
  image?: string;
  lang?: string;
}

const {
  title,
  description,
  image = "/images/og-default.jpg",
  lang = "en",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = "SDN Faucet - Sanitary Ware Manufacturer";
---

<!doctype html>
<html lang="{lang}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Quanzhou Shengdanni Sanitary Ware Co., Ltd." />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Quanzhou Shengdanni Sanitary Ware Co., Ltd.",
        "alternateName": "SDN Faucet",
        "url": "https://www.sdnfaucet.com",
        "description": "Professional sanitary ware manufacturer specializing in kitchen faucets, basin faucets, shower systems, and bathroom accessories for global B2B buyers.",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Quanzhou",
          "addressRegion": "Fujian",
          "addressCountry": "CN"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "email": "sales@sdnfaucet.com",
          "contactType": "sales",
          "availableLanguage": ["English", "Chinese"]
        }
      }
    </script>

    <title>{title} | SDN Faucet</title>
  </head>
  <body class="min-h-screen bg-white antialiased">
    <slot />
  </body>
</html>
