---
import "@/styles/global.css";

export interface Props {
  title: string;
  description: string;
  image?: string;
  lang?: string;
}

const {
  title,
  description,
  image = "https://sc02.alicdn.com/kf/Af26bc4625fb345588d112662bb13cd09u.png",
  lang = "en",
} = Astro.props;

// RTL support: Arabic pages render right-to-left
const dir = lang === "ar" ? "rtl" : "ltr";

// Brand suffix: append once, and never when the incoming title already contains the brand
const fullTitle = title.includes("SDN Faucet") ? title : `${title} | SDN Faucet`;

// Canonical and hreflang resolution
const siteUrl = "https://www.sdnfaucet.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();

const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/^\/(zh|ar)(?=\/|$)/, "") || "/";
const enUrl = `${siteUrl}${cleanPath === "/" ? "" : cleanPath}`;
const zhUrl = `${siteUrl}/zh${cleanPath === "/" ? "" : cleanPath}`;
const arUrl = `${siteUrl}/ar${cleanPath === "/" ? "" : cleanPath}`;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>

    <!-- Canonical & Multilingual Hreflang -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh" href={zhUrl} />
    <link rel="alternate" hreflang="ar" href={arUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-white">
    <slot />
  </body>
</html>
