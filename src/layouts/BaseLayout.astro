---
import "@/styles/global.css";

export interface Props {
  title: string;
  description: string;
  image?: string;
  lang?: string;
}

const {
  title,
  description,
  image = "https://sc02.alicdn.com/kf/Af26bc4625fb345588d112662bb13cd09u.png",
  lang = "en",
} = Astro.props;

// RTL support: Arabic pages render right-to-left
const dir = lang === "ar" ? "rtl" : "ltr";

// Brand suffix: append once, and never when the incoming title already contains the brand
const fullTitle = title.includes("SDN Faucet") ? title : `${title} | SDN Faucet`;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-white">
    <slot />
  </body>
</html>
