  <div class="container-tight px-4">
    <div class="grid gap-12 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <div class="flex items-center gap-2 text-white">
          <span class="text-xl font-bold tracking-tight">SDN Faucet</span>
        </div>
        <p class="mt-4 text-sm leading-relaxed">
          Professional sanitary ware manufacturer from Quanzhou, China. Specializing in high-quality kitchen and bathroom solutions.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">Products</h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="/products" class="hover:text-white">Kitchen Faucets</a></li>
          <li><a href="/products" class="hover:text-white">Basin Mixers</a></li>
          <li><a href="/products" class="hover:text-white">Shower Systems</a></li>
          <li><a href="/products" class="hover:text-white">Accessories</a></li>
