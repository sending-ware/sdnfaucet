---
const currentYear = new Date().getFullYear();

const locale = Astro.currentLocale ?? "en";
const localePrefix = locale === "en" ? "" : `/${locale}`;

const labels = {
  en: {
    description:
      "Professional sanitary ware manufacturer from Quanzhou, China. Specializing in high-quality kitchen and bathroom solutions.",
    products: "Products",
    kitchenFaucets: "Kitchen Faucets",
    basinMixers: "Basin Mixers",
    showerSystems: "Shower Systems",
    accessories: "Accessories",
    company: "Company",
    aboutUs: "About Us",
    contact: "Contact",
    followUs: "Follow Us",
    address:
      "Room 501, Building 1, Defa Technology, Chengxiang Town, Anxi County, Quanzhou City, Fujian Province, China",
    telLabel: "TEL/WHATSAPP:",
    copyright: `© ${currentYear} Quanzhou Shengdanni Sanitary Ware Co., Ltd. All rights reserved.`,
  },
  zh: {
    description: "来自中国泉州的专业卫浴制造商，专注于高品质厨房与卫浴解决方案。",
    products: "产品",
    kitchenFaucets: "厨房水龙头",
    basinMixers: "面盆龙头",
    showerSystems: "淋浴系统",
    accessories: "卫浴配件",
    company: "公司",
    aboutUs: "关于我们",
    contact: "联系我们",
    followUs: "关注我们",
    address: "中国福建省泉州市安溪县城厢镇德阀科技园1号楼501室",
    telLabel: "电话/WhatsApp：",
    copyright: `© ${currentYear} 泉州圣丹尼卫浴有限公司 版权所有`,
  },
  ar: {
    description:
      "مصنع محترف للأدوات الصحية من تشيوانتشو بالصين. متخصصون في تقديم حلول عالية الجودة للمطبخ والحمام.",
    products: "المنتجات",
    kitchenFaucets: "خلاطات المطبخ",
    basinMixers: "خلاطات الأحواض",
    showerSystems: "أنظمة الدش",
    accessories: "الملحقات",
    company: "الشركة",
    aboutUs: "من نحن",
    contact: "اتصل بنا",
    followUs: "تابعنا على",
    address:
      "الغرفة 501، مبنى 1، مجمع ديفا التقني، بلدة تشنغشيانغ، مقاطعة آنشي، مدينة تشيوانتشو، مقاطعة فوجيان، الصين",
    telLabel: "الهاتف/واتساب:",
    copyright: `© ${currentYear} شركة تشيوانتشو شينغداني للأدوات الصحية المحدودة. جميع الحقوق محفوظة.`,
  },
};

const t = labels[locale] ?? labels.en;
---

<footer class="bg-gray-900 pt-16 pb-8 text-gray-300">
  <div class="container-tight px-4">
    <div class="grid gap-12 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <div class="flex items-center gap-2 text-white">
          <span class="text-xl font-bold tracking-tight">SDN Faucet</span>
        </div>
        <p class="mt-4 text-sm leading-relaxed">
          {t.description}
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">{t.products}</h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href={`${localePrefix}/products`} class="hover:text-white">{t.kitchenFaucets}</a></li>
          <li><a href={`${localePrefix}/products`} class="hover:text-white">{t.basinMixers}</a></li>
          <li><a href={`${localePrefix}/products`} class="hover:text-white">{t.showerSystems}</a></li>
          <li><a href={`${localePrefix}/products`} class="hover:text-white">{t.accessories}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">{t.company}</h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href={`${localePrefix}/about`} class="hover:text-white">{t.aboutUs}</a></li>
          <li><a href={`${localePrefix}/contact`} class="hover:text-white">{t.contact}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">{t.contact}</h3>
        <ul class="mt-4 space-y-3 text-sm">
          <li>{t.address}</li>
          <li>
            <a href="mailto:sending@sdnfaucet.com" class="hover:text-white">sending@sdnfaucet.com</a>
          </li>
          <li>
            {t.telLabel} +86 17750519615
          </li>
        </ul>

        <div class="mt-4">
          <p class="text-sm font-semibold text-white">{t.followUs}</p>
          <div class="mt-2 flex items-center gap-3">
            <a href="https://www.linkedin.com/in/%E4%B8%B9%E5%A6%AE-%E5%9C%A3-40bb79422/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-gray-400 transition hover:text-white">
              <svg class="h-5 w-5" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-16 border-t border-gray-800 pt-8 text-center text-xs">
      <p>{t.copyright}</p>
    </div>
  </div>
</footer>
