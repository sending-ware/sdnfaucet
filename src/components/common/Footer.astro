---
// Footer Component
---

<footer class="border-t border-gray-100 bg-gray-50">
  <div class="container-tight px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div>
        <a href="/" class="text-lg font-bold text-ocean-700">SDN Faucet</a>
        <p class="mt-3 text-sm leading-relaxed text-gray-500">
          Professional sanitary ware manufacturer from Quanzhou, China. Specializing in kitchen faucets, basin faucets, shower systems, and bathroom accessories.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-sm font-semibold text-gray-900">Products</h4>
        <ul class="mt-3 space-y-2">
          <li><a href="/products" class="text-sm text-gray-500 hover:text-ocean-600">Kitchen Faucets</a></li>
          <li><a href="/products" class="text-sm text-gray-500 hover:text-ocean-600">Basin Faucets</a></li>
          <li><a href="/products" class="text-sm text-gray-500 hover:text-ocean-600">Shower Systems</a></li>
          <li><a href="/products" class="text-sm text-gray-500 hover:text-ocean-600">Accessories</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="text-sm font-semibold text-gray-900">Company</h4>
        <ul class="mt-3 space-y-2">
          <li><a href="/about" class="text-sm text-gray-500 hover:text-ocean-600">About Us</a></li>
          <li><a href="/contact" class="text-sm text-gray-500 hover:text-ocean-600">Contact</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-sm font-semibold text-gray-900">Contact</h4>
        <ul class="mt-3 space-y-2 text-sm text-gray-500">
          <li>Quanzhou, Fujian, China</li>
          <li>
            <a href="mailto:sales@sdnfaucet.com" class="hover:text-ocean-600">
              sales@sdnfaucet.com
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-gray-200 pt-6 text-center text-xs text-gray-400">
      &copy; {new Date().getFullYear()} Quanzhou Shengdanni Sanitary Ware Co., Ltd. All rights reserved.
    </div>
  </div>
</footer>
