---
// Header Component
const navLinks = [
  { label: "Products", href: "/products" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];
---

<header class="sticky top-0 z-50 border-b border-gray-100 bg-white/95 backdrop-blur-sm">
  <nav class="container-tight flex items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2 text-xl font-bold text-ocean-700">
      <span class="text-2xl">💧</span>
      <span class="hidden sm:inline">SDN Faucet</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-8 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-gray-600 transition-colors hover:text-ocean-600"
        >
          {link.label}
        </a>
      ))}
      <a href="/contact" class="btn-primary text-sm !py-2 !px-4">
        Get Quote
      </a>
    </div>

    <!-- Mobile menu button (placeholder) -->
    <button
      class="inline-flex items-center justify-center rounded-lg p-2 text-gray-600 hover:bg-gray-100 md:hidden"
      aria-label="Open menu"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>
</header>
