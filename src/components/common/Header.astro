---
// Header Component
import LanguageSwitcher from "./LanguageSwitcher.astro";
const locale = Astro.currentLocale ?? "en";
const localePrefix = locale === "en" ? "" : `/${locale}`;

const translations = {
  en: {
    products: "Products",
    blog: "Blog",
    about: "About",
    contact: "Contact",
    getQuote: "Get Quote",
    openMenu: "Open menu",
    closeMenu: "Close menu",
    language: "Language",
  },
  zh: {
    products: "产品中心",
    blog: "技术百科",
    about: "关于我们",
    contact: "联系我们",
    getQuote: "获取报价",
    openMenu: "打开菜单",
    closeMenu: "关闭菜单",
    language: "语言",
  },
  ar: {
    products: "المنتجات",
    blog: "الموسوعة التقنية",
    about: "حول",
    contact: "اتصل بنا",
    getQuote: "اطلب سعراً",
    openMenu: "فتح القائمة",
    closeMenu: "إغلاق القائمة",
    language: "اللغة",
  },
};

const t = translations[locale as keyof typeof translations] || translations.en;

const navLinks = [
  { label: t.products, href: "/products" },
  { label: t.blog, href: "/blog" },
  { label: t.about, href: "/about" },
  { label: t.contact, href: "/contact" },
];
---

<header class="sticky top-0 z-50 border-b border-gray-100 bg-white/95 backdrop-blur-sm">
  <nav class="container-tight flex items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a href={localePrefix || "/"} class="flex items-center gap-2 text-xl font-bold text-ocean-700">
      <span class="text-2xl">💧</span>
      <span class="hidden sm:inline">SDN Faucet</span>
    </a>
    <!-- Desktop nav -->
    <div class="hidden items-center gap-8 md:flex">
      {navLinks.map((link) => (
        <a href={`${localePrefix}${link.href}`} class="text-sm font-medium text-gray-600 transition-colors hover:text-ocean-600">
          {link.label}
        </a>
      ))}
      <a href={`${localePrefix}/contact`} class="btn-primary text-sm !py-2 !px-4">
        {t.getQuote}
      </a>
      <LanguageSwitcher />
    </div>
    <!-- Mobile menu toggle -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-lg p-2 text-gray-600 hover:bg-gray-100 md:hidden"
      aria-label={t.openMenu}
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-label-open={t.openMenu}
      data-label-close={t.closeMenu}
    >
      <svg id="mobile-menu-icon-open" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="mobile-menu-icon-close" class="hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="hidden border-t border-gray-100 bg-white px-4 pb-6 pt-2 shadow-lg md:hidden">
    <nav class="flex flex-col" aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a
          href={`${localePrefix}${link.href}`}
          class="mobile-menu-link border-b border-gray-50 py-3 text-base font-medium text-gray-700 transition-colors hover:text-ocean-600"
        >
          {link.label}
        </a>
      ))}
      <a href={`${localePrefix}/contact`} class="btn-primary mt-4 w-full text-center text-sm !py-3">
        {t.getQuote}
      </a>
    </nav>
    <div class="mt-4 flex items-center justify-between gap-3">
      <span class="text-sm font-medium text-gray-500">{t.language}</span>
      <LanguageSwitcher />
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var toggle = document.getElementById("mobile-menu-toggle");
    var menu = document.getElementById("mobile-menu");
    if (!toggle || !menu) return;
    var iconOpen = document.getElementById("mobile-menu-icon-open");
    var iconClose = document.getElementById("mobile-menu-icon-close");
    var labelOpen = toggle.getAttribute("data-label-open") || "Open menu";
    var labelClose = toggle.getAttribute("data-label-close") || "Close menu";

    function setMenu(open) {
      menu.classList.toggle("hidden", !open);
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute("aria-label", open ? labelClose : labelOpen);
      if (iconOpen) iconOpen.classList.toggle("hidden", open);
      if (iconClose) iconClose.classList.toggle("hidden", !open);
    }

    toggle.addEventListener("click", function () {
      setMenu(menu.classList.contains("hidden"));
    });

    // Close the menu when any link inside it is activated
    menu.querySelectorAll("a").forEach(function (a) {
      a.addEventListener("click", function () {
        setMenu(false);
      });
    });
  })();
</script>
