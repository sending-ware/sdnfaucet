---
// Turnstile Script — load once, render one widget, and reset it for retries
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
---

<script id="turnstile-api" is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" defer></script>
<script is:inline define:vars={{ siteKey }}>
  (() => {
    const state = window.__turnstileState || {
      widgetId: null,
      status: "idle",
      token: undefined,
    };
    window.__turnstileState = state;

    const renderWidget = () => {
      const container = document.getElementById("turnstile-container");
      if (!container || !window.turnstile || !siteKey) return false;
      if (state.widgetId !== null && ["loading", "ready"].includes(state.status)) {
        return true;
      }
      if (container.dataset.turnstileRendered === "true") return true;

      state.status = "loading";
      state.token = undefined;
      state.widgetId = window.turnstile.render(container, {
        sitekey: siteKey,
        callback: (token) => {
          state.token = token;
          state.status = "ready";
          window.turnstileToken = token;
        },
        "expired-callback": () => {
          state.token = undefined;
          state.status = "expired";
          window.turnstileToken = undefined;
        },
        "error-callback": () => {
          state.token = undefined;
          state.status = "error";
          window.turnstileToken = undefined;
        },
        theme: "light",
      });
      container.dataset.turnstileRendered = "true";
      return true;
    };

    const retryWidget = () => {
      state.token = undefined;
      window.turnstileToken = undefined;
      if (state.widgetId !== null && window.turnstile?.reset) {
        state.status = "loading";
        window.turnstile.reset(state.widgetId);
        return true;
      }
      const container = document.getElementById("turnstile-container");
      if (container) {
        container.replaceChildren();
        delete container.dataset.turnstileRendered;
      }
      state.widgetId = null;
      state.status = "idle";
      return renderWidget();
    };

    window.__renderTurnstile = renderWidget;
    window.__retryTurnstile = retryWidget;
    window.turnstileLoadCallback = renderWidget;

    const boot = () => {
      if (renderWidget()) return;
      window.clearInterval(window.__turnstilePollId);
      window.__turnstilePollId = window.setInterval(() => {
        if (renderWidget()) {
          window.clearInterval(window.__turnstilePollId);
        }
      }, 150);
      window.setTimeout(() => window.clearInterval(window.__turnstilePollId), 15000);
    };

    document.getElementById("turnstile-api")?.addEventListener("load", boot, { once: true });
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot, { once: true });
    } else {
      boot();
    }
  })();
</script>
