---
// Turnstile Script — loads Cloudflare Turnstile only when a real site key is configured.
//
// IMPORTANT: there is deliberately NO fallback to the Cloudflare test site key
// ("1x00000000000000000000AA"). Using a test key in production renders a
// "For testing only" widget that can get stuck ("Checking your Browser",
// "Verification failed", "Verification expired") and blocks real visitors.
//
// If PUBLIC_TURNSTILE_SITE_KEY is missing — or is set to one of Cloudflare's
// well-known test keys — the widget is skipped entirely and QuickInquiry shows
// a localized configuration message with email/WhatsApp fallbacks instead of
// leaving the user stuck.

// Cloudflare's published test site keys. They must never be served to
// production visitors, even if an environment variable is misconfigured.
const TURNSTILE_TEST_KEYS = [
  "1x00000000000000000000AA", // always passes
  "2x00000000000000000000AB", // always blocks
  "1x00000000000000000000AB", // forces interactive challenge
  "1x00000000000000000000BB", // forces non-interactive challenge
];

const configuredKey = (import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "").trim();
const siteKey = TURNSTILE_TEST_KEYS.includes(configuredKey)
  ? ""
  : configuredKey;
const hasSiteKey = siteKey.length > 0;
---

{hasSiteKey && (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&amp;onload=onloadTurnstileCallback"
    defer
  ></script>
)}
<script is:inline define:vars={{ siteKey }}>
  (function () {
    window.__turnstileState = {
      siteKey: siteKey || null,
      widgetId: null,
      // loading | ready | error | expired | unconfigured
      status: siteKey ? "loading" : "unconfigured",
    };

    function notify(eventName) {
      try {
        window.dispatchEvent(new CustomEvent(eventName));
      } catch (err) {
        /* ignore */
      }
    }

    function renderTurnstile() {
      var state = window.__turnstileState;
      var container = document.getElementById("turnstile-container");
      // No site key configured: never render a test widget, never block users.
      if (!container || !state.siteKey) return;

      // API not ready yet — will be retried via onload callback / timeout.
      if (typeof turnstile === "undefined") {
        state.status = "loading";
        return;
      }

      // A widget already exists and is still active (loading/ready): never
      // remove and re-render it. Doing so on every mount/retry is what
      // produces rapid duplicate or stuck widgets for desktop visitors.
      // Re-render only when there is no widget yet or the previous one hit a
      // terminal state (error/expired).
      if (
        state.widgetId !== null &&
        (state.status === "loading" || state.status === "ready")
      ) {
        return;
      }

      // Terminal state (error/expired): drop the stale widget before
      // rendering a fresh one.
      if (state.widgetId !== null) {
        try {
          turnstile.remove(state.widgetId);
        } catch (err) {
          /* ignore */
        }
        state.widgetId = null;
      }

      state.status = "loading";
      try {
        state.widgetId = turnstile.render(container, {
          sitekey: state.siteKey,
          callback: function (token) {
            window.turnstileToken = token;
            state.status = "ready";
            notify("turnstile:success");
          },
          "error-callback": function () {
            window.turnstileToken = undefined;
            state.status = "error";
            notify("turnstile:error");
          },
          "expired-callback": function () {
            window.turnstileToken = undefined;
            state.status = "expired";
            notify("turnstile:expired");
          },
          theme: "light",
        });
      } catch (err) {
        state.status = "error";
        notify("turnstile:error");
      }
    }

    window.__renderTurnstile = renderTurnstile;

    // Public retry path: clears any stale token, then resets the existing
    // widget in place (non-destructive, avoids duplicate widgets). Falls back
    // to a fresh remove/re-render only when the widget cannot be reset.
    window.__retryTurnstile = function () {
      var state = window.__turnstileState;
      window.turnstileToken = undefined;
      if (
        state.widgetId !== null &&
        typeof turnstile !== "undefined" &&
        typeof turnstile.reset === "function"
      ) {
        try {
          turnstile.reset(state.widgetId);
          state.status = "loading";
          return;
        } catch (err) {
          /* fall through to remove/re-render */
        }
      }
      renderTurnstile();
    };

    if (!siteKey) return;

    window.onloadTurnstileCallback = renderTurnstile;

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", renderTurnstile);
    } else {
      renderTurnstile();
    }

    // Safety net: the container may not exist yet when the API callback
    // fires (e.g. React hydrates after the API has already loaded).
    setTimeout(renderTurnstile, 1500);
  })();
</script>
